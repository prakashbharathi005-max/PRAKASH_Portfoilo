<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Prakash B — VLSI Design & Verification Engineer</title>
<meta name="description" content="Professional VLSI Design & Verification portfolio of Prakash B. RTL Architect, SystemVerilog developer, and digital verification specialist interning at Taras Systems."/>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@300;400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        cyan: { 400:'#22d3ee', 500:'#06b6d4' },
        emerald: { 400:'#34d399', 500:'#10b981' },
        slate: { 950:'#020617', 900:'#0f172a', 800:'#1e293b', 700:'#334155' }
      },
      fontFamily: {
        display: ['Syne','sans-serif'],
        mono: ['JetBrains Mono','monospace'],
        body: ['Inter','sans-serif']
      }
    }
  }
}
</script>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:#020617;color:#f1f5f9;font-family:'Inter',sans-serif;overflow-x:hidden}

  /* ── Circuit background ─────────────────────────── */
  .circuit-bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.18}
  .circuit-bg svg{width:100%;height:100%}

  /* ── Scanline overlay ───────────────────────────── */
  .scanline{position:fixed;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(6,182,212,.015) 2px,rgba(6,182,212,.015) 4px)}

  /* ── Glow effects ───────────────────────────────── */
  .glow-cyan{box-shadow:0 0 30px rgba(6,182,212,.25),0 0 60px rgba(6,182,212,.1)}
  .glow-emerald{box-shadow:0 0 30px rgba(16,185,129,.2),0 0 60px rgba(16,185,129,.08)}
  .text-glow{text-shadow:0 0 40px rgba(6,182,212,.6)}
  .border-glow:hover{box-shadow:0 0 20px rgba(6,182,212,.3);border-color:rgba(6,182,212,.6)!important;transition:all .3s}

  /* ── Glass card ─────────────────────────────────── */
  .glass{backdrop-filter:blur(12px);background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08)}
  .glass:hover{background:rgba(255,255,255,.07);border-color:rgba(6,182,212,.25);transition:all .35s}

  /* ── Nav ────────────────────────────────────────── */
  nav{position:fixed;top:0;left:0;right:0;z-index:100;backdrop-filter:blur(20px);background:rgba(2,6,23,.8);border-bottom:1px solid rgba(6,182,212,.15)}

  /* ── Hero typing cursor ─────────────────────────── */
  .cursor::after{content:'|';animation:blink 1s infinite;color:#06b6d4}
  @keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

  /* ── Fade-in animations ─────────────────────────── */
  .fade-up{opacity:0;transform:translateY(32px);transition:opacity .7s ease,transform .7s ease}
  .fade-up.visible{opacity:1;transform:translateY(0)}

  /* ── Skill badge ────────────────────────────────── */
  .skill-badge{display:inline-flex;align-items:center;gap:.4rem;padding:.35rem .85rem;border-radius:9999px;font-family:'JetBrains Mono',monospace;font-size:.72rem;font-weight:500;border:1px solid;transition:all .25s;cursor:default}
  .skill-badge:hover{transform:translateY(-2px);box-shadow:0 4px 20px rgba(6,182,212,.3)}

  /* ── Timeline line ──────────────────────────────── */
  .timeline-line{position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(180deg,#06b6d4,#10b981,transparent)}

  /* ── Cert card ──────────────────────────────────── */
  .cert-badge{width:10px;height:10px;border-radius:50%;flex-shrink:0;margin-top:4px}

  /* ── Stat counter ───────────────────────────────── */
  .stat-card{position:relative;overflow:hidden}
  .stat-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(6,182,212,.08),rgba(16,185,129,.05));pointer-events:none}

  /* ── Section label ──────────────────────────────── */
  .section-label{font-family:'JetBrains Mono',monospace;font-size:.7rem;letter-spacing:.2em;color:#06b6d4;text-transform:uppercase;margin-bottom:.5rem}

  /* ── Mobile nav toggle ──────────────────────────── */
  #mobile-menu{display:none}
  #mobile-menu.open{display:flex}

  /* ── Scrollbar ──────────────────────────────────── */
  ::-webkit-scrollbar{width:4px}
  ::-webkit-scrollbar-track{background:#020617}
  ::-webkit-scrollbar-thumb{background:#06b6d4;border-radius:2px}

  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  .float{animation:float 4s ease-in-out infinite}

  @keyframes pulse-ring{0%{transform:scale(1);opacity:.6}100%{transform:scale(1.6);opacity:0}}
  .pulse-ring{animation:pulse-ring 2s ease-out infinite}
</style>
</head>
<body>

<!-- ░░ Circuit Background ░░ -->
<div class="circuit-bg">
  <svg viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <filter id="glow"><feGaussianBlur stdDeviation="2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    </defs>
    <g stroke="#06b6d4" stroke-width="1" fill="none" filter="url(#glow)">
      <!-- Horizontal traces -->
      <path d="M0,150 H200 L230,180 H500 L530,150 H900 L930,120 H1400"/>
      <path d="M0,400 H100 L130,430 H400 L430,400 H700 L730,370 H1000 L1030,400 H1400"/>
      <path d="M0,650 H300 L330,620 H600 L630,650 H850 L880,680 H1400"/>
      <!-- Vertical traces -->
      <path d="M200,0 V150 L230,180 V300 L200,330 V600"/>
      <path d="M500,0 V80 L530,150 V280 L500,310 V500"/>
      <path d="M900,0 V120 L930,150 V380 L900,410 V750 L930,780 V900"/>
      <path d="M700,200 V370 L730,400 V600 L700,630 V900"/>
      <!-- Component boxes -->
      <rect x="220" y="160" width="50" height="40" rx="2"/>
      <rect x="510" y="130" width="60" height="40" rx="2"/>
      <rect x="910" y="100" width="70" height="40" rx="2"/>
      <rect x="710" y="350" width="50" height="40" rx="2"/>
      <rect x="310" y="610" width="50" height="40" rx="2"/>
      <!-- Dots at junctions -->
      <circle cx="200" cy="150" r="3" fill="#06b6d4"/>
      <circle cx="530" cy="150" r="3" fill="#06b6d4"/>
      <circle cx="930" cy="120" r="3" fill="#10b981"/>
      <circle cx="130" cy="430" r="3" fill="#06b6d4"/>
      <circle cx="730" cy="370" r="3" fill="#10b981"/>
      <circle cx="330" cy="620" r="3" fill="#06b6d4"/>
      <circle cx="880" cy="680" r="3" fill="#10b981"/>
      <!-- Via holes -->
      <circle cx="400" cy="300" r="5" stroke="#10b981"/>
      <circle cx="800" cy="500" r="5" stroke="#06b6d4"/>
      <circle cx="600" cy="700" r="5" stroke="#10b981"/>
      <circle cx="1100" cy="250" r="5" stroke="#06b6d4"/>
    </g>
    <!-- Extra faint traces -->
    <g stroke="#10b981" stroke-width=".5" fill="none" opacity=".5">
      <path d="M0,50 H600 L650,100 H1400"/>
      <path d="M0,800 H400 L450,750 H1000 L1050,800 H1400"/>
      <path d="M1200,0 V200 L1170,230 V900"/>
      <path d="M50,0 V400 L80,430 V900"/>
    </g>
  </svg>
</div>
<div class="scanline"></div>

<!-- ░░ NAV ░░ -->
<nav>
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#hero" class="font-display font-bold text-lg text-white flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-cyan-500 pulse-ring inline-block"></span>
      <span class="text-glow">PB</span>
    </a>
    <div class="hidden md:flex items-center gap-8 font-mono text-xs text-slate-400">
      <a href="#about" class="hover:text-cyan-400 transition-colors">about</a>
      <a href="#skills" class="hover:text-cyan-400 transition-colors">skills</a>
      <a href="#experience" class="hover:text-cyan-400 transition-colors">experience</a>
      <a href="#projects" class="hover:text-cyan-400 transition-colors">projects</a>
      <a href="#certifications" class="hover:text-cyan-400 transition-colors">certs</a>
      <a href="#contact" class="px-4 py-2 border border-cyan-500/50 rounded text-cyan-400 hover:bg-cyan-500/10 transition-all">contact</a>
    </div>
    <button id="menu-btn" class="md:hidden text-slate-300" onclick="document.getElementById('mobile-menu').classList.toggle('open')">
      <i class="fas fa-bars text-lg"></i>
    </button>
  </div>
  <div id="mobile-menu" class="flex-col gap-4 px-6 pb-4 font-mono text-sm text-slate-400 border-t border-slate-800 pt-3">
    <a href="#about" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="hover:text-cyan-400">about</a>
    <a href="#skills" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="hover:text-cyan-400">skills</a>
    <a href="#experience" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="hover:text-cyan-400">experience</a>
    <a href="#projects" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="hover:text-cyan-400">projects</a>
    <a href="#certifications" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="hover:text-cyan-400">certifications</a>
    <a href="#contact" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="hover:text-cyan-400">contact</a>
  </div>
</nav>

<!-- ░░ HERO ░░ -->
<section id="hero" class="relative z-10 min-h-screen flex items-center pt-20">
  <div class="max-w-6xl mx-auto px-6 w-full py-20">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <div class="fade-up">
        <!-- Profile Photo -->
        <div class="mb-6 flex items-center gap-5">
          <div class="relative">
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-2 border-cyan-500/50 glow-cyan">
              <img src="prakash-photo.jpg" alt="Prakash B" class="w-full h-full object-cover object-top" />
            </div>
            <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 rounded-full border-2 border-slate-950 flex items-center justify-center">
              <i class="fas fa-check text-[8px] text-white"></i>
            </div>
          </div>
          <p class="section-label mb-0">// VLSI Design & Verification Engineer</p>
        </div>
        <h1 class="font-display font-extrabold text-5xl sm:text-6xl lg:text-7xl leading-tight mb-6">
          <span class="text-white">Prakash</span><br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400 text-glow">B</span>
        </h1>
        <p class="text-slate-400 text-lg leading-relaxed mb-8 max-w-lg font-body">
          RTL architect & digital verification specialist. Building silicon from the ground up — one Verilog module at a time.
        </p>
        <div class="flex flex-wrap gap-3 mb-10">
          <span class="skill-badge bg-cyan-500/10 border-cyan-500/30 text-cyan-300"><i class="fas fa-microchip text-xs"></i> Verilog HDL</span>
          <span class="skill-badge bg-emerald-500/10 border-emerald-500/30 text-emerald-300"><i class="fas fa-code text-xs"></i> SystemVerilog</span>
          <span class="skill-badge bg-slate-700/50 border-slate-600/50 text-slate-300"><i class="fas fa-layer-group text-xs"></i> FPGA Design</span>
          <span class="skill-badge bg-slate-700/50 border-slate-600/50 text-slate-300"><i class="fas fa-wave-square text-xs"></i> RTL Design</span>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="#projects" class="px-6 py-3 bg-cyan-500 text-slate-950 font-display font-bold rounded hover:bg-cyan-400 transition-all hover:shadow-lg hover:shadow-cyan-500/30 text-sm">
            View Projects <i class="fas fa-arrow-right ml-2"></i>
          </a>
          <a href="#contact" class="px-6 py-3 border border-slate-600 text-slate-300 font-display font-semibold rounded hover:border-cyan-500/50 hover:text-cyan-300 transition-all text-sm">
            Get In Touch
          </a>
        </div>
      </div>

      <!-- Interactive Core System Console & Metrics -->
      <div class="fade-up glass rounded-2xl border border-slate-700/50 p-6 flex flex-col glow-cyan relative overflow-hidden h-[440px] md:h-[450px]">
        <!-- Glass tabs header -->
        <div class="flex border-b border-slate-800 pb-3 mb-4 justify-between items-center flex-wrap gap-2 relative z-10">
          <div class="flex gap-2">
            <button id="tab-metrics" onclick="switchHeroTab('metrics')" class="px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
              <i class="fas fa-chart-bar mr-1.5"></i> METRICS
            </button>
            <button id="tab-sim" onclick="switchHeroTab('sim')" class="px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all text-slate-400 hover:text-slate-200">
              <i class="fas fa-terminal mr-1.5"></i> SIMULATOR
            </button>
            <button id="tab-waves" onclick="switchHeroTab('waves')" class="px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all text-slate-400 hover:text-slate-200">
              <i class="fas fa-wave-square mr-1.5"></i> WAVEFORMS
            </button>
          </div>
          <div class="flex items-center gap-1.5 font-mono text-[9px] text-slate-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse-ring"></span>
            <span id="sim-indicator-label" class="text-emerald-400">CORE: LIVE</span>
          </div>
        </div>

        <!-- Content Area -->
        <div class="flex-1 overflow-y-auto pr-1 relative z-10">
          <!-- Tab Content 1: Metrics -->
          <div id="content-metrics" class="grid grid-cols-2 gap-3 h-full">
            <div class="stat-card glass rounded-xl p-4 text-center border-glow flex flex-col justify-center">
              <div class="text-2xl font-display font-extrabold text-cyan-400 mb-0.5">8.19</div>
              <div class="text-[10px] text-slate-500 font-mono">CGPA / 10.0</div>
              <div class="text-[9px] text-slate-600 font-mono">5th Sem · Anna Univ</div>
            </div>
            <div class="stat-card glass rounded-xl p-4 text-center border-glow flex flex-col justify-center">
              <div class="text-2xl font-display font-extrabold text-emerald-400 mb-0.5">6+</div>
              <div class="text-[10px] text-slate-500 font-mono">Certifications</div>
              <div class="text-[9px] text-slate-600 font-mono">NPTEL · Infosys · Maven</div>
            </div>
            <div class="stat-card glass rounded-xl p-4 text-center border-glow flex flex-col justify-center">
              <div class="text-2xl font-display font-extrabold text-cyan-400 mb-0.5">₹10K</div>
              <div class="text-[10px] text-slate-500 font-mono">Seed Funding</div>
              <div class="text-[9px] text-slate-600 font-mono">CCET-IIC Grant</div>
            </div>
            <div class="stat-card glass rounded-xl p-4 text-center border-glow flex flex-col justify-center">
              <div class="text-2xl font-display font-extrabold text-emerald-400 mb-0.5">100%</div>
              <div class="text-[10px] text-slate-500 font-mono">Test Success</div>
              <div class="text-[9px] text-slate-600 font-mono">I2C RTL Verification</div>
            </div>
            <!-- NPTEL score card -->
            <div class="stat-card glass rounded-xl p-4 col-span-2 border-glow">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-[10px] text-slate-400">NPTEL — IoT (IIT Kharagpur)</span>
                <span class="text-[10px] font-mono text-emerald-400 font-bold">ELITE ★</span>
              </div>
              <div class="w-full bg-slate-800 rounded-full h-1.5">
                <div class="h-1.5 rounded-full bg-gradient-to-r from-cyan-500 to-emerald-400" style="width:85%"></div>
              </div>
              <div class="flex justify-between mt-1 text-[9px]">
                <span class="text-slate-600 font-mono">Score</span>
                <span class="text-cyan-400 font-mono font-bold">85%</span>
              </div>
            </div>
          </div>

          <!-- Tab Content 2: Simulator -->
          <div id="content-sim" class="hidden flex flex-col h-full font-mono text-[11px] text-slate-300">
            <div class="flex flex-col h-full bg-black/60 rounded-xl border border-slate-800 p-4 leading-relaxed overflow-hidden relative">
              <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-2 text-[9px] text-slate-500">
                <span>SYSTEM_CONSOLE // i2c_master_slave_tb.sv</span>
                <span id="sim-status" class="text-cyan-400 animate-pulse">STATUS: RUNNING</span>
              </div>
              <div id="terminal-output" class="flex-1 overflow-y-auto space-y-1.5 pr-1 text-slate-300 font-mono text-[10px] max-h-[220px]">
                <!-- Dynamic logs appended here -->
              </div>
              <div class="mt-2 pt-2 border-t border-slate-800 flex justify-between items-center text-[10px] text-slate-500">
                <span class="text-slate-600">prakash@silicon-core:~$</span>
                <div class="flex gap-2">
                  <button onclick="restartSimulation()" class="hover:text-cyan-400 transition-colors text-[9px] border border-slate-700 rounded px-1.5 py-0.5 bg-slate-900/40"><i class="fas fa-redo"></i> Restart</button>
                  <button id="btn-toggle-sim" onclick="toggleSimulation()" class="hover:text-cyan-400 transition-colors text-[9px] border border-slate-700 rounded px-1.5 py-0.5 bg-slate-900/40"><i class="fas fa-pause"></i> Pause</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Tab Content 3: Waveforms -->
          <div id="content-waves" class="hidden flex flex-col h-full">
            <div class="flex flex-col h-full bg-slate-950/80 rounded-xl border border-slate-800 p-4 font-mono text-[11px] select-none overflow-hidden relative">
              <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-3 text-[9px] text-slate-500">
                <span>LOGIC_ANALYZER // sda_scl_signals</span>
                <span class="text-emerald-400 font-bold animate-pulse">TRIGGERED</span>
              </div>
              
              <div class="flex-1 relative flex flex-col justify-between">
                <!-- Waveform Graph SVG -->
                <div class="relative w-full h-[150px] bg-slate-900/30 border border-slate-800/80 rounded p-2 overflow-hidden flex items-center">
                  <!-- Gridlines -->
                  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:16px_16px]"></div>
                  
                  <svg viewBox="0 0 360 100" class="w-full h-full">
                    <!-- Labels inside SVG -->
                    <text x="5" y="25" fill="#fbbf24" font-family="JetBrains Mono" font-size="8px" font-weight="bold">SCL</text>
                    <text x="5" y="65" fill="#22d3ee" font-family="JetBrains Mono" font-size="8px" font-weight="bold">SDA</text>
                    
                    <!-- SCL Path -->
                    <path d="M 30,25 H 38 V 10 H 46 V 25 H 54 V 10 H 62 V 25 H 70 V 10 H 78 V 25 H 86 V 10 H 94 V 25 H 102 V 10 H 110 V 25 H 118 V 10 H 126 V 25 H 134 V 10 H 142 V 25 H 150 V 10 H 158 V 25 H 166 V 10 H 174 V 25 H 182 V 10 H 190 V 25 H 198 V 10 H 206 V 25 H 214 V 10 H 222 V 25 H 230 V 10 H 238 V 25 H 246 V 10 H 254 V 25 H 262 V 10 H 270 V 25 H 278 V 10 H 286 V 25 H 294 V 10 H 302 V 25 H 310 V 10 H 318 V 25 H 326 V 10 H 334 V 25 H 342 V 10" stroke="#fbbf24" stroke-width="1.5" fill="none" opacity="0.85" />

                    <!-- SDA Path -->
                    <path id="sda-wave-path" d="M 20,55 H 34 V 75 H 46 V 55 H 54 V 75 H 94 V 75 H 110 V 55 H 118 V 75 H 126 V 55 H 134 V 75 H 150 V 55 H 158 V 75 H 166 V 55 H 174 V 75 H 182 V 55 H 200" stroke="#22d3ee" stroke-width="1.5" fill="none" opacity="0.9" />

                    <!-- Vertical Scanning Cursor -->
                    <line id="wave-cursor" x1="30" y1="5" x2="30" y2="95" stroke="#ef4444" stroke-width="1.5" opacity="0.8" />
                  </svg>
                </div>

                <!-- Live stats/labels -->
                <div class="grid grid-cols-3 gap-2 mt-3 text-[10px] text-slate-400 text-center">
                  <div class="bg-slate-900/60 rounded p-1.5 border border-slate-800/40">
                    <span class="block text-slate-500 font-mono text-[8px] uppercase">State</span>
                    <span id="wave-state" class="text-cyan-400 font-semibold uppercase">IDLE</span>
                  </div>
                  <div class="bg-slate-900/60 rounded p-1.5 border border-slate-800/40">
                    <span class="block text-slate-500 font-mono text-[8px] uppercase">Bus Status</span>
                    <span id="wave-sda-val" class="text-amber-400 font-bold uppercase">IDLE</span>
                  </div>
                  <div class="bg-slate-900/60 rounded p-1.5 border border-slate-800/40">
                    <span class="block text-slate-500 font-mono text-[8px] uppercase">Timing Margin</span>
                    <span class="text-emerald-400 font-bold">+1.48 ns</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-600 text-xs font-mono">
      <span>scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-slate-600 to-transparent"></div>
    </div>
  </div>
</section>

<!-- ░░ ABOUT ░░ -->
<section id="about" class="relative z-10 py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="fade-up mb-12">
      <p class="section-label">01. about</p>
      <h2 class="font-display font-bold text-3xl text-white">Who I Am</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8 fade-up">
      <div class="md:col-span-2 glass rounded-xl p-8">
        <p class="text-slate-300 leading-relaxed text-base mb-6 font-body">
          Final-year B.E. Electronics & Communication Engineering student at <span class="text-cyan-400 font-semibold">Chettinad College of Engineering & Technology, Karur</span> (Anna University), with a focused specialisation in VLSI design, RTL architecture, and digital verification.
