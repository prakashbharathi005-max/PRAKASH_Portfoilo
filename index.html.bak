<footer class="relative z-10 border-t border-slate-800 py-8">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="font-display font-bold text-white text-sm">Prakash B <span class="text-cyan-500">·</span> VLSI Design & Verification</p>
    <p class="text-slate-600 text-xs font-mono">B.E. ECE · Chettinad CCET · Batch of 2026</p>
  </div>
</footer>

<script>
// Fade-up on scroll
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

// Hero Interactive Tabs Logic
function switchHeroTab(tabName) {
  const tabs = ['metrics', 'sim', 'waves'];
  tabs.forEach(t => {
    const btn = document.getElementById(`tab-${t}`);
    const content = document.getElementById(`content-${t}`);
    if (t === tabName) {
      btn.className = "px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all bg-cyan-500/15 text-cyan-300 border border-cyan-500/30";
      content.classList.remove('hidden');
    } else {
      btn.className = "px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all text-slate-400 hover:text-slate-200";
      content.classList.add('hidden');
    }
  });
}

// Simulator & Waveform Sync Core Logic
const simSteps = [
  { x: 30, state: "IDLE", bus: "BUS FREE", log: "[SYSTEM] Initializing I2C Master-Slave testbench...", class: "text-slate-500" },
  { x: 34, state: "START", bus: "START_COND", log: "[TB] Detected START condition: SDA drops while SCL is High.", class: "text-cyan-400 font-semibold" },
  { x: 42, state: "ADDR", bus: "Bit 6: 1", log: "[RTL] Driving Address Bit 6 = 1", class: "text-slate-400" },
  { x: 50, state: "ADDR", bus: "Bit 5: 0", log: "[RTL] Driving Address Bit 5 = 0", class: "text-slate-400" },
  { x: 58, state: "ADDR", bus: "Bit 4: 1", log: "[RTL] Driving Address Bit 4 = 1", class: "text-slate-400" },
  { x: 66, state: "ADDR", bus: "Bit 3: 0", log: "[RTL] Driving Address Bit 3 = 0", class: "text-slate-400" },
  { x: 74, state: "ADDR", bus: "Bit 2: 0", log: "[RTL] Driving Address Bit 2 = 0", class: "text-slate-400" },
  { x: 82, state: "ADDR", bus: "Bit 1: 0", log: "[RTL] Driving Address Bit 1 = 0", class: "text-slate-400" },
  { x: 90, state: "ADDR", bus: "Bit 0: 0", log: "[RTL] Driving Address Bit 0 = 0 -> Target Slave: 7'h50.", class: "text-cyan-400/80" },
  { x: 98, state: "WRITE", bus: "WR Bit: 0", log: "[RTL] Driving WR Bit = 0 (WRITE instruction).", class: "text-slate-400" },
  { x: 106, state: "ACK1", bus: "ACK: 0", log: "[SVA] Assertion: ACK detected from target Slave.", class: "text-emerald-400 font-bold" },
  { x: 114, state: "DATA", bus: "Data Bit 7: 1", log: "[RTL] Master writing Data Bit 7 = 1", class: "text-slate-400" },
  { x: 122, state: "DATA", bus: "Data Bit 6: 0", log: "[RTL] Master writing Data Bit 6 = 0", class: "text-slate-400" },
  { x: 130, state: "DATA", bus: "Data Bit 5: 1", log: "[RTL] Master writing Data Bit 5 = 1", class: "text-slate-400" },
  { x: 138, state: "DATA", bus: "Data Bit 4: 0", log: "[RTL] Master writing Data Bit 4 = 0", class: "text-slate-400" },
  { x: 146, state: "DATA", bus: "Data Bit 3: 0", log: "[RTL] Master writing Data Bit 3 = 0", class: "text-slate-400" },
  { x: 154, state: "DATA", bus: "Data Bit 2: 1", log: "[RTL] Master writing Data Bit 2 = 1", class: "text-slate-400" },
  { x: 162, state: "DATA", bus: "Data Bit 1: 0", log: "[RTL] Master writing Data Bit 1 = 0", class: "text-slate-400" },
  { x: 170, state: "DATA", bus: "Data Bit 0: 1", log: "[RTL] Master writing Data Bit 0 = 1 -> Byte 8'hA5 sent.", class: "text-cyan-400/80" },
  { x: 178, state: "ACK2", bus: "ACK: 0", log: "[SVA] Assertion: ACK detected from Slave for write byte.", class: "text-emerald-400 font-bold" },
  { x: 186, state: "STOP", bus: "STOP_COND", log: "[TB] Detected STOP condition: SDA rises while SCL is High.", class: "text-cyan-400 font-semibold" },
  { x: 200, state: "IDLE", bus: "BUS FREE", log: "[VERIF] Scoreboard check SUCCESS: 8'hA5 verified in RAM.", class: "text-emerald-500 font-bold" },
  { x: 220, state: "IDLE", bus: "BUS FREE", log: "[VERIF] Code & Functional Coverage = 100.0%. Loop ending.", class: "text-emerald-400 font-medium" },
];

let currStep = 0;
let simInterval = null;
let isRunning = true;

function runStep() {
  if (currStep >= simSteps.length) {
    // Clear terminal periodically
    const terminal = document.getElementById('terminal-output');
    if (terminal) terminal.innerHTML = '';
    currStep = 0;
  }

  const step = simSteps[currStep];
  
  // Update wave cursor position
  const cursor = document.getElementById('wave-cursor');
  if (cursor) cursor.setAttribute('x1', step.x);
  if (cursor) cursor.setAttribute('x2', step.x);

  // Update status labels
  const waveState = document.getElementById('wave-state');
  const waveSda = document.getElementById('wave-sda-val');
  if (waveState) waveState.textContent = step.state;
  if (waveSda) waveSda.textContent = step.bus;

  // Append terminal logs
  const terminal = document.getElementById('terminal-output');
  if (terminal) {
    const logLine = document.createElement('div');
    logLine.className = step.class;
    logLine.innerHTML = `<span class="text-slate-500 text-[9px] mr-1.5">[${new Date().toLocaleTimeString().split(' ')[0]}]</span>${step.log}`;
    terminal.appendChild(logLine);
    terminal.scrollTop = terminal.scrollHeight;
  }

  currStep++;
}

function startSimulation() {
  if (!simInterval) {
    simInterval = setInterval(runStep, 650);
  }
}

function toggleSimulation() {
  const btn = document.getElementById('btn-toggle-sim');
  const indicator = document.getElementById('sim-indicator-label');
  const status = document.getElementById('sim-status');
  
  if (isRunning) {
    clearInterval(simInterval);
    simInterval = null;
    isRunning = false;
    if (btn) btn.innerHTML = '<i class="fas fa-play"></i> Play';
    if (indicator) {
      indicator.textContent = 'CORE: PAUSED';
      indicator.className = 'text-amber-500';
    }
    if (status) {
      status.textContent = 'STATUS: PAUSED';
      status.className = 'text-amber-500 animate-pulse';
    }
  } else {
    isRunning = true;
    startSimulation();
    if (btn) btn.innerHTML = '<i class="fas fa-pause"></i> Pause';
    if (indicator) {
      indicator.textContent = 'CORE: LIVE';
      indicator.className = 'text-emerald-400';
    }
    if (status) {
      status.textContent = 'STATUS: RUNNING';
      status.className = 'text-cyan-400 animate-pulse';
    }
  }
}

function restartSimulation() {
  const terminal = document.getElementById('terminal-output');
  if (terminal) terminal.innerHTML = '';
  currStep = 0;
  if (!isRunning) {
    toggleSimulation();
  } else {
    clearInterval(simInterval);
    simInterval = null;
    startSimulation();
  }
}

// Auto start simulator on page load
startSimulation();
</script>
</body>
</html>
